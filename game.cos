        HMM WATIF(c3 == "O")
            HMM WATIF(c5 == "O")
                HMM WATIF(NO{c4 == "X"})
                    HMM WATIF(NO{c4 == "O"})
                        "aiMove" CHANGETO-> 4
                        SPITOUT("AI FOUND A WINNING MOVE.")
    HMM WATIF(aiMove == -1)
        HMM WATIF(c4 == "O")
            HMM WATIF(c5 == "O")
                HMM WATIF(NO{c3 == "X"})
                    HMM WATIF(NO{c3 == "O"})
                        "aiMove" CHANGETO-> 3
                        SPITOUT("AI FOUND A WINNING MOVE.")
    HMM WATIF(aiMove == -1)
        HMM WATIF(c6 == "O")
