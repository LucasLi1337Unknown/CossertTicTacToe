    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c0 == "X"})
            HMM WATIF(NO{c0 == "O"})
                "aiMove" CHANGETO-> 0
                SPITOUT("AI TAKES A CORNER.")
    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c2 == "X"})
            HMM WATIF(NO{c2 == "O"})
