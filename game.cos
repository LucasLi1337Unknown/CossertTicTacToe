    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c7 == "X"})
            HMM WATIF(NO{c7 == "O"})
                "aiMove" CHANGETO-> 7
                SPITOUT("AI TAKES AN EDGE.")
    HMM WATIF(aiMove >= 0)
        UREPLACEIT{board}[aiMove] W/"O"
        SPITOUT("AI CHOSE SQUARE:")
        SPITOUT(aiMove)
        FINALANSER(aiMove)
    FINALANSER(-1)
}

SPITOUT("======================================")
SPITOUT("        COSSERT TIC TAC TOE")
SPITOUT("======================================")
SPITOUT("1 = HUMAN VS HUMAN")
SPITOUT("2 = HUMAN VS AI")

GOAROUND 20 TIMES:
    YO USER DILE("Choose mode 1 or 2: "): gameMode
    HMM WATIF(gameMode == 1)
        FRGETABTIT
    HMM WATIF(gameMode == 2)
        FRGETABTIT
    SPITOUT("THAT MODE DOES NOT EXIST.")

HMM WATIF(gameMode == 1)
    SPITOUT("MODE: HUMAN VS HUMAN")
HMM WATIF(gameMode == 2)
    SPITOUT("MODE: HUMAN VS AI")
    SPITOUT("YOU ARE X. THE AI IS O.")

GET "firstShow" LETITB SHOWBOARD()

GOAROUND 20 TIMES:
    SPITOUT("CURRENT PLAYER:")
    SPITOUT(turn)

    HMM WATIF(turn == "X")
        GET "humanXMove" LETITB HUMANMOVE()

    HMM WATIF(turn == "O")
        HMM WATIF(gameMode == 1)
            GET "humanOMove" LETITB HUMANMOVE()
        HMM WATIF(gameMode == 2)
            GET "computerMove" LETITB AIMOVE()

    "newCount" CHANGETO-> YO COMBINE movesMade W/1
    "movesMade" CHANGETO-> newCount
    GET "afterMoveShow" LETITB SHOWBOARD()
    "won" CHANGETO-> CHECKWIN()

    HMM WATIF(won == 1)
        SPITOUT("======================================")
        SPITOUT("WINNER:")
        SPITOUT(turn)
        HMM WATIF(gameMode == 2)
            HMM WATIF(turn == "X")
                SPITOUT("HUMAN BEAT THE COSSERT AI.")
            HMM WATIF(turn == "O")
                SPITOUT("THE COSSERT AI HAS DEFEATED YOU.")
        SPITOUT("======================================")
        FRGETABTIT

    HMM WATIF(movesMade == 9)
        SPITOUT("======================================")
        SPITOUT("DRAW. NOBODY GETS THE GLORY.")
        SPITOUT("======================================")
        FRGETABTIT

    "oldTurn" CHANGETO-> turn
    HMM WATIF(oldTurn == "X")
        "turn" CHANGETO-> "O"
    HMM WATIF(oldTurn == "O")
        "turn" CHANGETO-> "X"

OKALFINEBYE
