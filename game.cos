    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c8 == "X"})
            HMM WATIF(NO{c8 == "O"})
                "aiMove" CHANGETO-> 8
                SPITOUT("AI TAKES A CORNER.")
    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c1 == "X"})
            HMM WATIF(NO{c1 == "O"})
                "aiMove" CHANGETO-> 1
                SPITOUT("AI TAKES AN EDGE.")
    HMM WATIF(aiMove == -1)
        HMM WATIF(NO{c3 == "X"})
            HMM WATIF(NO{c3 == "O"})
                "aiMove" CHANGETO-> 3
